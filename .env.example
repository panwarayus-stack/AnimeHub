# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_VIDEO_BASE_URL: Cloudflare R2 public bucket or custom domain base URL
# Leave empty to use fallback demo streams.
# When your R2 bucket is ready, set this to: https://pub-xxxxxx.r2.dev or https://media.yourdomain.com
VITE_VIDEO_BASE_URL=""
